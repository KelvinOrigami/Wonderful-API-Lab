{
  "name": "wonderful-api-lab",
  "version": "1.0.0",
  "description": "Playwright API testing lab for the Restful API",
  "main": "index.js",
  "scripts": {
    "test:api": "playwright test tests/api",
    "test:api:smoke": "playwright test tests/api --grep @smoke",
    "test:api:regression": "playwright test tests/api --grep @regression",
    "test:api:list": "playwright test tests/api --list",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KelvinOrigami/Wonderful-API-Lab.git"
  },
