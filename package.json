  "bugs": {
    "url": "https://github.com/KelvinOrigami/Wonderful-API-Lab/issues"
  },
  "homepage": "https://github.com/KelvinOrigami/Wonderful-API-Lab#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "dotenv": "^17.2.2",
    "typescript": "^5.9.2"
  }
}
